---
import { example45 } from '@/flame/examples/example45'
import StudioFlame from './StudioFlame.tsx'

// Build the TRANSFORMS readout straight from the flame the viewport renders, so
// the panel is the *actual* math behind it — not mock numbers.
const swatches = ['#06d6c8', '#d4e157', '#ff5e7e', '#60a5fa', '#a3e635']
const affineKeys = ['a', 'b', 'c', 'd', 'e', 'f'] as const

const fmt = (n: number) => (n < 0 ? '' : ' ') + n.toFixed(2)
const prettyVar = (type: string) =>
  type
    .replace(/Var$/, '')
    .replace(/3D$/, '3D')
    .toUpperCase()

const transforms = Object.values(example45.transforms)
const total = transforms.reduce((s, t) => s + t.probability, 0)
const rows = transforms.map((t, i) => ({
  label: `F${i}`,
  swatch: swatches[i % swatches.length],
  prob: (t.probability / total).toFixed(2),
  affine: affineKeys.map((k) => ({ k, v: fmt(t.preAffine[k]) })),
  vars: Object.values(t.variations).map((v) => ({
    name: prettyVar(v.type),
    weight: v.weight,
  })),
}))

const zoom = example45.renderSettings.camera.zoom.toFixed(2)
---

<section id="studio" class="wrap">
  <p class="kicker">Under the hood</p>
  <h2>The math, live.</h2>
  <p class="sec-lede">
    Define affine transforms and variations, weight their probabilities, and let
    the GPU resolve millions of iterations in real time. Here's the hero flame,
    laid bare.
  </p>

  <div class="studio-stage">
    <div class="studio-viewport">
      <StudioFlame client:only="solid-js" />
      <span class="corner c1"></span><span class="corner c2"></span>
      <span class="corner c3"></span><span class="corner c4"></span>
      <div class="hud">
        <div class="row"><span>VIEWPORT · live</span><span>spectrum swirl</span></div>
        <div class="row"><span>zoom {zoom}×</span><span>move to explore</span></div>
      </div>
    </div>

    <div class="panel">
      <div class="ph"><span>transforms</span><span class="live">solving</span></div>
      {
        rows.map((r) => (
          <div class="xform">
            <div class="xh">
              <span class="swatch" style={`background:${r.swatch}`} />
              {r.label}
              <span class="prob">p {r.prob}</span>
            </div>
            <div class="matrix">
              {r.affine.map((c) => (
                <span>
                  {c.k} <b>{c.v}</b>
                </span>
              ))}
            </div>
            <div class="vbar">
              {r.vars.map((v) => (
                <span class="vtag">
                  {v.name} {v.weight}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .studio-stage {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 18px;
    align-items: stretch;
  }
  .studio-viewport {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    min-height: 440px;
  }
  .studio-viewport :global(astro-island) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--neutral-400);
    letter-spacing: 0.04em;
  }
  .hud .row {
    display: flex;
    justify-content: space-between;
  }
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .c1 {
    top: 10px;
    left: 10px;
    border-right: 0;
    border-bottom: 0;
  }
  .c2 {
    top: 10px;
    right: 10px;
    border-left: 0;
    border-bottom: 0;
  }
  .c3 {
    bottom: 10px;
    left: 10px;
    border-right: 0;
    border-top: 0;
  }
  .c4 {
    bottom: 10px;
    right: 10px;
    border-left: 0;
    border-top: 0;
  }

  .panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: var(--neutral-950);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--mono);
  }
  .ph {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    color: var(--neutral-500);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .live {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--blue-400);
  }
  .live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue-400);
    box-shadow: 0 0 8px var(--blue-400);
    animation: blink 1.4s infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  .xform {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 11px 12px;
  }
  .xh {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    color: var(--neutral-200);
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .prob {
    margin-left: auto;
    color: var(--neutral-500);
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 10px;
    margin-top: 9px;
    font-size: 0.72rem;
    color: var(--neutral-400);
  }
  .matrix b {
    color: #fff;
    font-weight: 500;
  }
  .vbar {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 9px;
  }
  .vtag {
    font-size: 0.64rem;
    padding: 3px 7px;
    border-radius: 4px;
    background: rgba(96, 165, 250, 0.12);
    color: var(--blue-300);
  }

  @media (max-width: 860px) {
    .studio-stage {
      grid-template-columns: 1fr;
    }
  }
</style>
