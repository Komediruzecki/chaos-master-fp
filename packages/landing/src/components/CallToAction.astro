---
const appUrl = 'https://chaos-master.com'
---

<section id="start" class="cta-section">
  <div class="container cta-box">
    <h2>Start making fractals</h2>
    <p>Free, open source, and runs entirely in your browser.</p>
    <a class="btn btn-primary" href={appUrl}>Launch Chaos Master →</a>
  </div>

  <style>
    .cta-box {
      text-align: center;
      background: linear-gradient(
        160deg,
        rgba(255, 0, 128, 0.12),
        rgba(121, 40, 202, 0.12)
      );
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 64px 24px;
    }
    .cta-box h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 800;
    }
    .cta-box p {
      color: var(--fg-muted);
      font-size: 1.1rem;
      margin: 16px 0 32px;
    }
  </style>
</section>
