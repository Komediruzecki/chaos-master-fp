---
const appUrl = 'https://chaos-master.com'
const repoUrl = 'https://github.com/chaos-matters/chaos-master'
---

<nav class="nav">
  <div class="wrap nav-in">
    <a class="brand" href="#top"><span class="dot"></span>Chaos Master</a>
    <div class="nav-links">
      <a class="hide" href="#features">Features</a>
      <a class="hide" href="#gallery">Gallery</a>
      <a class="hide" href={repoUrl}>GitHub</a>
      <a class="pill btn btn-primary" href={appUrl}>Launch app →</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.7),
      rgba(0, 0, 0, 0)
    );
  }
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-size: 0.82rem;
    text-transform: uppercase;
  }
  .brand .dot {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: conic-gradient(
      from 210deg,
      #06d6c8,
      #d4e157,
      #ff5e7e,
      #7928ca,
      #06d6c8
    );
    box-shadow: 0 0 18px rgba(96, 165, 250, 0.45);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.9rem;
    color: var(--neutral-400);
  }
  .nav-links a:hover {
    color: #fff;
  }
  .nav-links .pill {
    color: #fff;
  }

  @media (max-width: 860px) {
    .nav-links .hide {
      display: none;
    }
  }
</style>
