---
const appUrl = 'https://chaos-master.com'
---

<header class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">WebGPU · Real-time · In your browser</p>
      <h1>
        Generate <span class="brand-gradient">IFS flame fractals</span> in real time
      </h1>
      <p class="lede">
        Chaos Master is a high-performance fractal flame generator for artists
        and explorers — interactive affine editing, metadata-rich exports, and
        GPU-accelerated rendering, all with no install.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={appUrl}>Launch Chaos Master →</a>
        <a
          class="btn btn-ghost"
          href="https://github.com/chaos-matters/chaos-master">View on GitHub</a
        >
      </div>
      <p class="note">
        Requires a WebGPU-enabled browser (Chrome/Edge 113+, Safari 17+).
      </p>
    </div>
    <div class="hero-art">
      <img
        src="/hero-flame.jpg"
        alt="A vivid IFS flame fractal rendered by Chaos Master"
        width="640"
        height="640"
        loading="eager"
      />
    </div>
  </div>

  <style>
    .hero {
      position: relative;
      overflow: hidden;
      padding-top: 72px;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: -40% 30% auto -20%;
      height: 600px;
      background: radial-gradient(
        circle,
        rgba(121, 40, 202, 0.35),
        transparent 60%
      );
      filter: blur(20px);
      z-index: 0;
    }
    .hero-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
      align-items: center;
      padding-block: 64px;
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      color: var(--fg-muted);
      margin: 0 0 16px;
    }
    h1 {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 800;
    }
    .lede {
      color: var(--fg-muted);
      font-size: 1.15rem;
      line-height: 1.6;
      max-width: 46ch;
      margin: 24px 0 32px;
    }
    .cta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .note {
      margin-top: 18px;
      font-size: 0.85rem;
      color: var(--fg-muted);
    }
    .hero-art img {
      width: 100%;
      height: auto;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    }
    @media (max-width: 860px) {
      .hero-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .lede {
        margin-inline: auto;
      }
      .cta {
        justify-content: center;
      }
      .hero-art {
        order: -1;
      }
    }
  </style>
</header>
