{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chaos-master-landing",
  "compatibility_date": "2026-05-17",

  // Static-only site: no `main` worker, just the built Astro output served
  // directly by Cloudflare's static assets. The app (packages/app) owns the
  // root domain; this landing page lives on a subdomain.
  "assets": {
    "directory": "dist",
  },

  "env": {
    "prod": {
      "name": "chaos-master-landing",
      "routes": [
        {
          // DNS: add a CNAME/record for this subdomain in Cloudflare first.
          "pattern": "www.chaos-master.com",
          "custom_domain": true,
        },
      ],
      "build": {
        "command": "pnpm run build",
      },
    },
    "dev": {
      "name": "chaos-master-landing-dev",
      "routes": [
        {
          "pattern": "www.dev.chaos-master.com",
          "custom_domain": true,
        },
      ],
      "build": {
        "command": "pnpm run build",
      },
    },
  },
}
