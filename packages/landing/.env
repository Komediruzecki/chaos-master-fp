# Pipe device console logs to the dev-server terminal (dev only). Off by default.
# Override locally in .env.local (gitignored) — e.g. PUBLIC_REMOTE_LOG=true — to
# debug phones/tablets that have no usable console. See remoteLogPlugin in
# astro.config.mjs + the interceptor in src/layouts/Base.astro.
PUBLIC_REMOTE_LOG=false
