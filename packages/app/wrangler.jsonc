{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chaos-master",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  // Modern Cloudflare Assets configuration.
  // `binding` exposes env.ASSETS so the Worker can fetch the built index.html
  // (needed to inject OG/Twitter meta tags for shared links). `run_worker_first`
  // makes the Worker handle navigations + APIs while the hashed /assets/* files
  // stay static-first (served directly, no Worker invocation).
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "main": "src/worker/index.ts",

  "env": {
    "prod": {
      "name": "chaos-master",
      // Hostnames a Turnstile token may have been solved on (pins the token to
      // this origin). Keep in sync with the Turnstile widget's hostname list.
      "vars": {
        "ENVIRONMENT": "prod",
        "TURNSTILE_ALLOWED_HOSTNAMES": "lumenapeiron.com",
      },
      "routes": [
        {
          "pattern": "lumenapeiron.com",
          "custom_domain": true,
        },
      ],
      // NO `build.command` here on purpose — see the dev env below.
      // Sweep stuck render jobs (fail + refund past the cutoff).
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "kv_namespaces": [
        {
          "binding": "KV_SHORTENER",
          "id": "7cf9ab98f6274a179d63cccbf3c93911",
        },
      ],
      "d1_databases": [
        {
          "binding": "CHAOS_DB",
          "database_name": "chaos-master-db",
          "database_id": "PLACEHOLDER_PROD_D1_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "OG_IMAGES",
          "bucket_name": "chaos-master-og-images",
        },
        {
          "binding": "RENDERS",
          "bucket_name": "chaos-master-renders",
        },
      ],
      // Home tab content: FlameDescriptor JSON served to the app so the
      // gallery renders real flames on the GPU. Curated rows are written with
      // gallery-admin; the Worker may only stage explicitly consented Discord
      // submissions as unpublished/pending rows for human moderation.
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "chaos-master-content",
          "database_id": "2b704d31-0bb6-48e4-a071-4ba9ad4f1088",
        },
      ],
      // Per-IP cap on share/OG write endpoints to bound abuse + cost.
      "ratelimits": [
        {
          "name": "API_RL",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 },
        },
        // Stricter cap dedicated to the Discord share endpoint: at most one
        // share per minute per IP (a real user won't out-pace this).
        {
          "name": "DISCORD_RL",
          "namespace_id": "2001",
          "simple": { "limit": 1, "period": 60 },
        },
        // Per-user burst cap on GPU render submissions (the credit ledger
        // bounds total spend; this stops scripted hammering of the endpoint).
        {
          "name": "RENDER_RL",
          "namespace_id": "3001",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
    "dev": {
      "name": "chaos-master-dev",
      // localhost included so `wrangler dev --env dev` accepts tokens solved on
      // the local Turnstile widget. Keep in sync with the widget hostname list.
      "vars": {
        "ENVIRONMENT": "dev",
        "STRIPE_SECRET_KEY": "",
        "STRIPE_WEBHOOK_SECRET": "",
        "STRIPE_PREMIUM_PRICE_ID": "",
        "STRIPE_PRO_PRICE_ID": "",
        "TURNSTILE_ALLOWED_HOSTNAMES": "dev.lumenapeiron.com,localhost",
      },
      "routes": [
        {
          "pattern": "dev.lumenapeiron.com",
          "custom_domain": true,
        },
      ],
      // DO NOT reintroduce `build.command` here.
      //
      // Wrangler runs a custom build for `dev` as well as `deploy`, and re-runs
      // it on every change under `watch_dir` — which defaults to `./src`, i.e.
      // the whole app. The documented dev setup (vite.config.ts) is vite on
      // :5173 proxying /api and /discord to `wrangler dev` on :8787, so during
      // development NOTHING reads the bundle wrangler would produce — vite
      // serves the app itself. Every save therefore kicked off a full
      // `vite build --mode development` (~1.5 GB, ~1 min) whose output was
      // discarded, and wrangler neither queues nor cancels them: an editing
      // session stacked dozens concurrently and OOM-killed the workstation
      // (four times, once at ~60 GB).
      //
      // Deploys build explicitly instead — CI at .github/workflows/deploy.yml
      // ("Build app" + "Verify build output"), and locally via the deploy:dev /
      // deploy:prod scripts in package.json.
      "kv_namespaces": [
        {
          "binding": "KV_SHORTENER",
          "id": "7cf9ab98f6274a179d63cccbf3c93911",
          "preview_id": "91bef067328b4904ad4cfbcbbcf980f2",
        },
      ],
      "d1_databases": [
        {
          "binding": "CHAOS_DB",
          "database_name": "chaos-master-db-dev",
          "database_id": "PLACEHOLDER_DEV_D1_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "OG_IMAGES",
          "bucket_name": "chaos-master-og-images-dev",
        },
        // `wrangler dev` simulates R2 locally, so this works with no real
        // bucket; a deployed dev env shares the staging renders bucket.
        {
          "binding": "RENDERS",
          "bucket_name": "chaos-master-renders-staging",
        },
      ],
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "chaos-master-content-dev",
          "database_id": "068d1ab5-4151-487c-a6c0-75ee7df85e5d",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RL",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "DISCORD_RL",
          "namespace_id": "2002",
          "simple": { "limit": 1, "period": 60 },
        },
        {
          "name": "RENDER_RL",
          "namespace_id": "3002",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
    // Fork-owned test deployment at staging.lumenapeiron.com. Behaves like
    // prod for credit enforcement (the lifecycle is the thing under test) but
    // allows the mock Stripe checkout, so tiers/credits can be exercised
    // without real money. dev/prod stay upstream-managed.
    "staging": {
      "name": "chaos-master-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "TURNSTILE_ALLOWED_HOSTNAMES": "staging.lumenapeiron.com",
        // The staging endpoint (4l7hb69v3wchcn) runs a CHROME_ENGINE=true
        // image, so the chrome renderer is offered here. Set "false" against a
        // Deno-only endpoint: chrome submits are then rejected rather than
        // silently served by Deno.
        "RUNPOD_CHROME_ENGINE": "true",
      },
      "routes": [
        {
          "pattern": "staging.lumenapeiron.com",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "kv_namespaces": [
        {
          "binding": "KV_SHORTENER",
          "id": "7cf9ab98f6274a179d63cccbf3c93911",
        },
      ],
      "d1_databases": [
        {
          "binding": "CHAOS_DB",
          "database_name": "chaos-master-db-staging",
          "database_id": "1d8cf6b7-5658-48b7-a7f1-7efdf88968d4",
        },
      ],
      "r2_buckets": [
        {
          "binding": "OG_IMAGES",
          "bucket_name": "chaos-master-og-images-dev",
        },
        {
          "binding": "RENDERS",
          "bucket_name": "chaos-master-renders-staging",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RL",
          "namespace_id": "1004",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "DISCORD_RL",
          "namespace_id": "2004",
          "simple": { "limit": 1, "period": 60 },
        },
        {
          "name": "RENDER_RL",
          "namespace_id": "3004",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
    "preview": {
      "name": "chaos-master-preview",
      "vars": {
        "ENVIRONMENT": "preview",
      },
      "kv_namespaces": [
        {
          "binding": "KV_SHORTENER",
          "id": "7cf9ab98f6274a179d63cccbf3c93911",
          "preview_id": "91bef067328b4904ad4cfbcbbcf980f2",
        },
      ],
      "d1_databases": [
        {
          "binding": "CHAOS_DB",
          "database_name": "chaos-master-db-preview",
          "database_id": "PLACEHOLDER_PREVIEW_D1_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "OG_IMAGES",
          "bucket_name": "chaos-master-og-images-dev",
        },
      ],
      // PR previews read the dev content so the gallery is populated there too.
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "chaos-master-content-dev",
          "database_id": "068d1ab5-4151-487c-a6c0-75ee7df85e5d",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RL",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "DISCORD_RL",
          "namespace_id": "2003",
          "simple": { "limit": 1, "period": 60 },
        },
        {
          "name": "RENDER_RL",
          "namespace_id": "3003",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
  },
}
